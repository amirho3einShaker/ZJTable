{
  "manifest_version": 3,
  "name": "ZJTable",
  "version": "1.0.0",
  "description": "Display JSON data as a table",
  "action": {
    "default_title": "Zenit Json Table"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "Icons/16.png",
    "48": "Icons/48.png",
    "128": "Icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "system.display"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}